# Copy to .env and fill in credentials for your provisioned auth database.
# Source this file only after reviewing its shell contents. Never commit .env.
AUTH_DB_USERNAME=auth_app
AUTH_DB_PASSWORD=
AUTH_DB_MIGRATION_USERNAME=auth_migrator
AUTH_DB_MIGRATION_PASSWORD=
AUTH_SERVER_PORT=9000
SPRING_PROFILES_ACTIVE=local
# Optional; omit to use the profile-specific local/docker hostname.
# AUTH_DB_URL=jdbc:postgresql://localhost:5432/auth_db

# Required for all profiles; generate local material via docs/development.md.
AUTH_ISSUER=https://auth.example.org
AUTH_RSA_PRIVATE_KEY=file:/run/secrets/auth-private.pem
AUTH_RSA_PUBLIC_KEY=file:/run/secrets/auth-public.pem
AUTH_RSA_KEY_ID=
# Only explicit dev/test client migrations require these encoded secrets.
# Use generated values from .local/auth/authorization.env; keep them stable.
# AUTH_TASK_CLIENT_SECRET_HASH=
# AUTH_KPI_CLIENT_SECRET_HASH=
